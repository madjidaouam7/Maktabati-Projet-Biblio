@page "/emprunts"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Biblio.Web.New.Authentication
@using Biblio.Web.New.Components.Shared
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider

<PageTitle>Emprunts</PageTitle>

<h1>Gestion des emprunts</h1>

@if (_successMessage is not null)
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

<AuthorizeView Roles="Admin,Bibliothecaire">
    <Authorized>
        <button class="btn btn-primary mb-3" @onclick="ToggleFormulaire"> @(_afficherFormulaire ? "Annuler" : "Emprunter un livre")
        </button>

        <Modal Titre="Emprunter un livre" Visible="@_afficherFormulaire" OnClose="FermerFormulaire">
            <EditForm Model="_formModel" OnValidSubmit="EnregistrerEmprunt" @key="_formModel">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-2">
                    <label>livre à emprunter</label>
                    <InputSelect class="form-select" @bind-Value="_formModel.LivreId">
                        <option value="0">-- Sélectionnez un livre --</option>
                        @foreach (var livre in _livres ?? [])
                        {
                            <option value="@livre.Id">@livre.Titre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formModel.LivreId)" />
                    @if (_livresError is not null)
                    {
                        <div class="text-danger">@_livresError</div>
                    }
                </div>

                <div class="mb-2">
                    <label>Date de retour prévue</label>
                    <InputDate class="form-control" @bind-Value="_formModel.DateRetourPrevue" />
                    <ValidationMessage For="@(() => _formModel.DateRetourPrevue)" />
                </div>

                @if (_createError is not null)
                {
                    <div class="alert alert-danger">
                        @_createError
                    </div>
                }

                <button type="submit" class="btn btn-success" disabled="@_isCreating">
                    @(_isCreating ? "Enregistrement..." : "Emprunter")
                </button>

                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="FermerFormulaire">
                    Annuler
                </button>

            </EditForm>
        </Modal>
    </Authorized>
</AuthorizeView>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-secondary" @onclick="() => _afficherEmpruntsActifs = false">
        Tous les emprunts (@(_emprunts?.Count ?? 0))
    </button>

    <button class="btn btn-secondary" @onclick="() => _afficherEmpruntsActifs = true">
        Emprunts actifs (@(_emprunts?.Count(e => e.DateRetourEffective == null) ?? 0))
    </button>
</div>

@if (_isLoading)
{
    <p><em>Chargement...</em></p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger"> @_errorMessage </div>
}
else if (_emprunts is null || !_emprunts.Any())
{
    <p>Aucun emprunt actif trouvé.</p>
}
else if (_afficherEmpruntsActifs && !_emprunts.Any(e => e.DateRetourEffective == null))
{
    <p>Aucun emprunt actif trouvé.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Livre</th>
                <th>Utilisateur</th>
                <th>Date emprunt</th>
                <th>Retour prévu</th>
                <th>Retour effectif</th>
                <th>État</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emprunt in _emprunts.Where(e => !_afficherEmpruntsActifs || e.DateRetourEffective == null))
            {
                <tr>
                    <td>@emprunt.Id</td>
                    <td>@emprunt.LivreTitre</td>
                    <td>@emprunt.Utilisateur</td>
                    <td>@emprunt.DateEmprunt.ToString("dd/MM/yyyy")</td>
                    <td>@emprunt.DateRetourPrevue.ToString("dd/MM/yyyy")</td>
                    <td>@(emprunt.DateRetourEffective?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>@emprunt.Etat</td>
                    <td>
                        <AuthorizeView Roles="Admin,Bibliothecaire">
                            <Authorized>
                                @if (emprunt.DateRetourEffective == null)
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => OuvrirConfirmationRetour(emprunt)">
                                        Retourner
                                    </button>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (afficherConfirmation)
{
    <Modal Titre="Confirmer le retour" Visible="@afficherConfirmation" OnClose="AnnulerConfirmation">
        <p>
            Voulez-vous confirmer le retour du livre
            <strong>@livreAConfirmer</strong> ?
        </p>

        @if (_returnError is not null)
        {
            <div class="alert alert-danger">
                @_returnError
            </div>
        }

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" @onclick="AnnulerConfirmation" disabled="@_isReturning">
                Annuler
            </button>

            <button type="button" class="btn btn-warning" @onclick="ConfirmerRetour" disabled="@_isReturning">
                @(_isReturning ? "Retour en cours..." : "Confirmer le retour")
            </button>
        </div>
    </Modal>
}

@code {
    private List<LivreDto>? _livres;
    private List<EmpruntDto>? _emprunts;
    private FormModel _formModel = new();

    private string? _successMessage;
    private string? _errorMessage;
    private string? _livresError;
    private string? _createError;
    private string? _returnError;

    private bool _isLoading = true;
    private bool _isCreating;
    private bool _isReturning;
    private bool _afficherFormulaire;
    private bool afficherConfirmation;
    private int idAConfirmer;
    private string livreAConfirmer = string.Empty;
    private bool _afficherEmpruntsActifs = false;

    [Parameter]
    [SupplyParameterFromQuery(Name = "livreId")]
    public int? LivreIdQuery { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await ChargerLivres();
        await ChargerEmprunts();
    }

    private async Task ChargerLivres()
    {
        _livresError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            const int taillePage = 100;
            var livres = new List<LivreDto>();
            var page = 1;
            var totalPages = 1;

            do
            {
                using var response = await client.GetAsync($"api/livres?page={page}&taillePage={taillePage}");

                if (!response.IsSuccessStatusCode)
                {
                    _livresError = "Impossible de charger la liste des livres.";
                    return;
                }

                var resultat = await response.Content.ReadFromJsonAsync<LivreListeResponse>();
                if (resultat?.Livres is null)
                {
                    throw new System.Text.Json.JsonException("La réponse de l'API ne contient pas la liste des livres.");
                }

                livres.AddRange(resultat.Livres);
                totalPages = resultat.TotalPages;
                page++;
            }
            while (page <= totalPages);

            _livres = livres;
        }
        catch (Exception exception)
        {
            _livresError = $"Impossible de charger la liste des livres : {exception.Message}";
        }
    }

    private async Task ChargerEmprunts()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.GetAsync("api/emprunts/historique");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger les emprunts.";
                return;
            }

            _emprunts = (await response.Content.ReadFromJsonAsync<List<EmpruntDto>>() ?? new())
                .OrderByDescending(e => e.DateEmprunt)
                .ToList();
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task EnregistrerEmprunt()
    {
        if (_isCreating)
            return;

        _isCreating = true;
        _createError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.PostAsJsonAsync("api/emprunts/emprunter", _formModel);

            if (!response.IsSuccessStatusCode)
            {
                _createError = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de l'emprunt.");
                return;
            }

            _successMessage = "Emprunt enregistré avec succès";
            _afficherFormulaire = false;

            await ChargerEmprunts();
            _ = FaireDisparaitreMessageSucces();
        }
        catch (Exception)
        {
            _createError = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isCreating = false;
        }
    }



    private void ToggleFormulaire()
    {
        _afficherFormulaire = !_afficherFormulaire;
        _createError = null;

        if (_afficherFormulaire)
        {
            _formModel = new FormModel();
        }
    }

    private void FermerFormulaire()
    {
        _afficherFormulaire = false;
        _createError = null;
    }

    private void OuvrirConfirmationRetour(EmpruntDto emprunt)
    {
        idAConfirmer = emprunt.Id;
        livreAConfirmer = emprunt.LivreTitre;
        _returnError = null;
        afficherConfirmation = true;
    }

    private void AnnulerConfirmation()
    {
        if (_isReturning)
            return;

        afficherConfirmation = false;
        idAConfirmer = 0;
        livreAConfirmer = string.Empty;
        _returnError = null;
    }

    private async Task ConfirmerRetour()
    {
        if (_isReturning)
            return;

        _isReturning = true;
        _returnError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");

            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.PostAsync(
                $"api/emprunts/{idAConfirmer}/retourner", null);

            if (!response.IsSuccessStatusCode)
            {
                _returnError = await ApiErrorMessageReader.ReadAsync(
                    response, "Impossible de retourner ce livre.");
                return;
            }

            _successMessage = "Livre retourné avec succès";

            afficherConfirmation = false;
            await ChargerEmprunts();
            _ = FaireDisparaitreMessageSucces();
        }
        catch (Exception)
        {
            _returnError = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isReturning = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (LivreIdQuery is > 0)
        {
            _formModel = new FormModel
            {
                LivreId = LivreIdQuery.Value
            };

            _createError = null;
            _afficherFormulaire = true;
        }
    }

    private async Task FaireDisparaitreMessageSucces()
    {
        await Task.Delay(5000);
        _successMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    public class EmpruntDto
    {
        public int Id { get; set; }
        public string LivreTitre { get; set; } = string.Empty;
        public string Utilisateur { get; set; } = string.Empty;
        public DateTime DateEmprunt { get; set; }
        public DateTime DateRetourPrevue { get; set; }
        public DateTime? DateRetourEffective { get; set; }
        public string Etat { get; set; } = string.Empty;
    }

    private class FormModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Sélectionnez un livre valide.")]
        public int LivreId { get; set; }

        [Required(ErrorMessage = "La date de retour prévue est obligatoire.")]
        public DateTime? DateRetourPrevue { get; set; }
    }

    public class LivreDto
    {
        public int Id { get; set; }
        public string Titre { get; set; } = string.Empty;
        public string ISBN { get; set; } = string.Empty;
        public DateTime DatePublication { get; set; }
        public int NombrePages { get; set; }
        public int NombreExemplaires { get; set; }
        public int AuteurId { get; set; }
        public string AuteurNomComplet { get; set; } = string.Empty;
        public int CategorieId { get; set; }
        public string CategorieNom { get; set; } = string.Empty;
    }

    private class LivreListeResponse
    {
        public List<LivreDto>? Livres { get; set; }
        public int TotalPages { get; set; }
    }
}
