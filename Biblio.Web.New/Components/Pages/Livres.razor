@page "/livres"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Biblio.Web.New.Authentication
@using Biblio.Web.New.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]

@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider
@inject ILogger<Livres> Logger


<PageTitle>Livres</PageTitle>

<div class="page-heading">
    <div>
        <h1>Gestion des livres</h1>
        <p class="page-description">Consultez et gérez le catalogue de la bibliothèque.</p>
    </div>
    <AuthorizeView Roles="Admin,Bibliothecaire">
        <Authorized>
            <button class="btn btn-primary" @onclick="ToggleFormulaire" disabled="@(_isCreating || _isLoadingForm)">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                @(_afficherFormulaire ? "Annuler" : "Ajouter un livre")
            </button>
        </Authorized>
    </AuthorizeView>
</div>

@if (_successMessage is not null)
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

<AuthorizeView Roles="Admin,Bibliothecaire">
    <Authorized Context="authorizedContext">
        <Modal Titre="@(idEnModification.HasValue ? "Modifier un livre" : "Ajouter un livre")"
               Visible="@_afficherFormulaire" OnClose="FermerFormulaire">
            <EditForm Model="_formModel" OnValidSubmit="EnregistrerFormulaire">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-2">
                    <label for="titre">Titre</label>
                    <InputText id="titre" class="form-control" @bind-Value="_formModel.Titre" />
                    <ValidationMessage For="@(() => _formModel.Titre)" />
                </div>

                <div class="mb-2">
                    <label for="isbn">ISBN</label>
                    <InputText id="isbn" class="form-control" @bind-Value="_formModel.ISBN" />
                    <ValidationMessage For="@(() => _formModel.ISBN)" />
                </div>

                <div class="mb-2">
                    <label for="date-publication">Date de publication</label>
                    <InputDate id="date-publication" class="form-control" @bind-Value="_formModel.DatePublication" />
                    <ValidationMessage For="@(() => _formModel.DatePublication)" />
                </div>

                <div class="mb-2">
                    <label for="nombre-pages">Nombre de pages</label>
                    <InputNumber id="nombre-pages" class="form-control" @bind-Value="_formModel.NombrePages" />
                    <ValidationMessage For="@(() => _formModel.NombrePages)" />
                </div>

                <div class="mb-2">
                    <label for="nombre-exemplaires">Nombre d'exemplaires</label>
                    <InputNumber id="nombre-exemplaires" class="form-control"
                                 @bind-Value="_formModel.NombreExemplaires" />
                    <ValidationMessage For="@(() => _formModel.NombreExemplaires)" />
                </div>

                <div class="mb-2">
                    <label for="auteur-id">Auteur associé</label>
                    <InputSelect class="form-select" @bind-Value="_formModel.AuteurId">
                        <option value="0">-- Sélectionnez un auteur --</option>
                        @foreach (var auteur in _auteurs ?? [])
                        {
                            <option value="@auteur.Id">@auteur.Nom</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formModel.AuteurId)" />
                    @if (_auteursError is not null)
                    {
                        <div class="text-danger">@_auteursError</div>
                    }
                </div>

                <div class="mb-2">
                    <label for="categorie-id">Catégorie associé</label>
                    <InputSelect class="form-select" @bind-Value="_formModel.CategorieId">
                        <option value="0">-- Sélectionnez une catégorie --</option>
                        @foreach (var categorie in _categories ?? [])
                        {
                            <option value="@categorie.Id">@categorie.Nom</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _formModel.CategorieId)" />
                    @if (_auteursError is not null)
                    {
                        <div class="text-danger">@_auteursError</div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="alert alert-danger">@_createError</div>
                }

                <button type="submit" class="btn btn-success" disabled="@_isCreating">
                    @(_isCreating ? "Enregistrement..." : idEnModification.HasValue ? "Enregistrer les modifications" :
                    "Ajouter le livre")
                </button>
                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="FermerFormulaire"
                        disabled="@_isCreating">
                    Annuler
                </button>
            </EditForm>
        </Modal>
    </Authorized>
</AuthorizeView>

<div class="book-toolbar">
    <div class="book-view-switches">
        <button class="@(!_afficherDisponibles ? "btn btn-secondary" : "btn btn-outline-secondary")"
                @onclick="() => _afficherDisponibles = false">
            Tous les livres
        </button>
        <button class="@(_afficherDisponibles ? "btn btn-secondary" : "btn btn-outline-secondary")"
                @onclick="() => _afficherDisponibles = true">
            Livres disponibles (@_totalLivresDisponibles)
        </button>
    </div>

    <div class="book-search-tools">
        <div class="book-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="text" class="form-control" placeholder="Rechercher un livre par titre..."
                   aria-label="Rechercher un livre par titre" @bind="_rechercheTitre" @bind:event="oninput" />
        </div>

        <div class="dropdown">
            <button type="button"
                    class="@(_auteurFiltreId != 0 || _categorieFiltreId != 0 ? "btn btn-secondary" : "btn btn-outline-secondary")"
                    @onclick="() => _afficherFiltres = !_afficherFiltres" aria-expanded="@_afficherFiltres"
                    aria-haspopup="true">
                <i class="bi bi-funnel me-1" aria-hidden="true"></i>
                Filtres
                @if (_auteurFiltreId != 0 || _categorieFiltreId != 0)
                {
                    <span class="badge bg-light text-secondary ms-1">Actifs</span>
                }
            </button>

            @if (_afficherFiltres)
            {
                <div class="dropdown-menu show p-3 book-filter-menu">
                    <div class="mb-2">
                        <label for="auteur-filtre" class="form-label">Auteur</label>
                        <select id="auteur-filtre" class="form-select" @bind="_auteurFiltreId">
                            <option value="0">Tous les auteurs</option>
                            @foreach (var auteur in (_livres ?? new())
                                .GroupBy(l => l.AuteurId)
                                .Select(g => g.First()))
                            {
                                <option value="@auteur.AuteurId">@auteur.AuteurNomComplet</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label for="categorie-filtre" class="form-label">Catégorie</label>
                        <select id="categorie-filtre" class="form-select" @bind="_categorieFiltreId">
                            <option value="0">Toutes les catégories</option>
                            @foreach (var categorie in (_livres ?? new())
                                .GroupBy(l => l.CategorieId)
                                .Select(g => g.First()))
                            {
                                <option value="@categorie.CategorieId">@categorie.CategorieNom</option>
                            }
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_isLoading)
{
    <p>Chargement...</p>
}
else if (!_afficherDisponibles && (_livres is null || _livres.Count == 0))
{
    @if (_errorMessage is null)
    {
        <p>Aucun livre enregistré.</p>
    }
}
else if (!_livres.Any(l =>
    (_auteurFiltreId == 0 || l.AuteurId == _auteurFiltreId) &&
    (_categorieFiltreId == 0 || l.CategorieId == _categorieFiltreId) &&
    (string.IsNullOrWhiteSpace(_rechercheTitre) ||
     l.Titre.Contains(_rechercheTitre, StringComparison.OrdinalIgnoreCase))))
{
    <div class="alert alert-secondary">
        Aucun livre correspondant aux critères sélectionnés.
    </div>
}
else if (!_afficherDisponibles)
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Auteur</th>
                <th>Catégorie</th>
                <th>Pages</th>
                <th>Exemplaires</th>
                <th>Disponibles</th>
                <AuthorizeView Roles="Admin,Bibliothecaire">
                    <Authorized>
                        <th>Actions</th>
                    </Authorized>
                </AuthorizeView>
            </tr>
        </thead>

        <tbody>
            @foreach (var livre in _livres
                .Where(l => _auteurFiltreId == 0 || l.AuteurId == _auteurFiltreId)
                .Where(l => _categorieFiltreId == 0 || l.CategorieId == _categorieFiltreId)
                 .Where(l => string.IsNullOrWhiteSpace(_rechercheTitre)
        || l.Titre.Contains(_rechercheTitre, StringComparison.OrdinalIgnoreCase)))
                
            {
                var exemplairesDisponibles = _livresDisponibles
                    .FirstOrDefault(x => x.Id == livre.Id)?
                    .NombreExemplairesDisponibles ?? 0;
                <tr>
                    <td>@livre.Id</td>
                    <td>@livre.Titre</td>
                    <td>@livre.AuteurNomComplet</td>
                    <td>@livre.CategorieNom</td>
                    <td>@livre.NombrePages</td>
                    <td>@livre.NombreExemplaires</td>
                    <td>@exemplairesDisponibles</td>
                    <td>
                        <AuthorizeView Roles="Admin,Bibliothecaire">
                            <Authorized>
                                <button class="btn btn-sm btn-success me-1" disabled="@(exemplairesDisponibles <= 0)"
                                        @onclick="() => EmprunterLivre(livre.Id)">
                                    Emprunter
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin,Bibliothecaire">
                            <Authorized>
                                <button class="btn btn-sm btn-primary" title="Modifier"
                                        @onclick="() => AfficherFormulaireModification(livre.Id)" disabled="@_isLoadingForm">
                                    @if (_isLoadingForm)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-pencil-square"></i>
                                    }
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => OuvrirConfirmationSuppression(livre.Id, livre.Titre)"><i
                                    class="bi bi-trash"></i></button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
else if (_livresDisponibles.Count == 0)
    {
        <p>Aucun livre disponible.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Exemplaires</th>
                    <th>Exemplaires disponibles</th>
                    <AuthorizeView Roles="Admin,Bibliothecaire">
                        <Authorized>
                            <th>Actions</th>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            </thead>

            <tbody>
                @foreach (var livre in _livresDisponibles)
                {
                    <tr>
                        <td>@livre.Id</td>
                        <td>@livre.Titre</td>
                        <td>@livre.AuteurNomComplet</td>
                        <td>@livre.NombreExemplaires</td>
                        <td>@livre.NombreExemplairesDisponibles</td>
                        <td>
                            <AuthorizeView Roles="Admin,Bibliothecaire">
                                <Authorized>
                                    <button class="btn btn-sm btn-primary" @onclick="() => AfficherFormulaireModification(livre.Id)"
                                            disabled="@_isLoadingForm">
                                        @(_isLoadingForm ? "Chargement..." : "Modifier")
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => OuvrirConfirmationSuppression(livre.Id, livre.Titre)">Supprimer</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (afficherConfirmation)
    {
        <Modal Titre="Supprimer un livre" Visible="@afficherConfirmation" OnClose="AnnulerConfirmation">
            <p>Voulez-vous vraiment supprimer le livre <strong>@nomAConfirmer</strong> ?</p>
            <p class="text-muted small">Cette action est irréversible.</p>
            @if (_deleteError is not null)
            {
                <div class="alert alert-danger" role="alert">@_deleteError</div>
            }
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="AnnulerConfirmation"
                        disabled="@_isDeleting">Annuler</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmerSuppression" disabled="@_isDeleting">
                    @(_isDeleting ? "Suppression..." : "Supprimer")
                </button>
            </div>
        </Modal>
    }

@code {
    private List<LivreDto>? _livres;
    private List<LivreDisponibleDto> _livresDisponibles = new();
    private List<AuteurDto>? _auteurs;
    private List<CategorieDto>? _categories;
    private string? _auteursError;
    private string? _categoriesError;
    private int _totalLivres;
    private int _totalLivresDisponibles;
    private bool _afficherDisponibles = false;
    private FormModel _formModel = new();
    private bool _isLoading = true;
    private string? _successMessage;
    private string? _errorMessage;
    private bool _isCreating;
    private string? _createError;
    private bool _isLoadingForm;
    private bool _isDeleting;
    private string? _deleteError;
    private bool _afficherFormulaire;
    private bool afficherConfirmation;
    private int idAConfirmer;
    private string nomAConfirmer = string.Empty;
    private int? idEnModification;
    private int _auteurFiltreId = 0;
    private int _categorieFiltreId = 0;
    private string _rechercheTitre = string.Empty;
    private bool _afficherFiltres;

    [Parameter]
    [SupplyParameterFromQuery(Name = "auteurId")]
    public int? AuteurIdQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "categorieId")]
    public int? CategorieIdQuery { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await TokenProvider.LoadTokenAsync();
        await ChargerLivres();
        await ChargerLivresDisponibles();
        await ChargerAuteurs();
        await ChargerCategories();
        AppliquerFiltresDepuisUrl();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ChargerLivres()
    {
        _isLoading = true;
        _errorMessage = null;
        var client = HttpClientFactory.CreateClient("BiblioApi");

        try
        {
            AjouterAuthorization(client);
            using var response = await client.GetAsync("api/livres");

            if (!response.IsSuccessStatusCode)
            {
                var detail = await LireErreurHttpAsync(response);
                Logger.LogWarning("GET {ApiBaseAddress}api/livres a échoué ({StatusCode}) : {Detail}",
                    client.BaseAddress, (int)response.StatusCode, detail);
                _errorMessage = $"Impossible de charger les livres. {detail}";
                return;
            }

            var resultat = await response.Content.ReadFromJsonAsync<LivreListeResponse>();
            if (resultat?.Livres is null)
            {
                throw new JsonException("La réponse de l'API ne contient pas la propriété 'Livres'.");
            }

            _livres = resultat.Livres;
            _totalLivres = resultat.TotalElements;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Impossible de joindre l'API des livres à {ApiBaseAddress}.", client.BaseAddress);
            _errorMessage = $"Impossible de contacter l'API à {client.BaseAddress}. Vérifiez qu'elle est démarrée. Détail : {exception.Message}";
        }
        catch (JsonException exception)
        {
            Logger.LogError(exception, "La réponse GET api/livres ne correspond pas au format JSON paginé attendu.");
            _errorMessage = $"La réponse de l'API des livres est invalide : {exception.Message}";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erreur inattendue lors du chargement des livres.");
            _errorMessage = $"Erreur inattendue lors du chargement des livres : {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChargerLivresDisponibles()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            AjouterAuthorization(client);

            using var response = await client.GetAsync("api/livres/disponibles");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger les livres disponibles.";
                return;
            }

            _livresDisponibles = await response.Content.ReadFromJsonAsync<List<LivreDisponibleDto>>() ?? new();

            _totalLivresDisponibles = _livresDisponibles.Count;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erreur lors du chargement des livres disponibles.");
            _errorMessage = "Une erreur est survenue lors du chargement des livres disponibles.";
        }
    }

    private async Task ChargerAuteurs()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.GetAsync("api/auteurs");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger les auteurs.";
                return;
            }

            var resultat = await response.Content.ReadFromJsonAsync<AuteursResponse>();
            _auteurs = resultat?.Auteurs ?? new List<AuteurDto>();
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChargerCategories()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.GetAsync("api/categories");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger les categories.";
                return;
            }

            var resultat = await response.Content.ReadFromJsonAsync<CategoriesResponse>();
            _categories = resultat?.Categories ?? new List<CategorieDto>();
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleFormulaire()
    {
        _afficherFormulaire = !_afficherFormulaire;
        _createError = null;
        _errorMessage = null;
        if (_afficherFormulaire)
        {
            _formModel = new FormModel();
            idEnModification = null;
        }
    }

    private void FermerFormulaire()
    {
        if (_isCreating)
        {
            return;
        }

        _afficherFormulaire = false;
        _createError = null;
        idEnModification = null;
    }

    private Task EnregistrerFormulaire()
    {
        return idEnModification.HasValue ? ModifierLivre() : HandleCreer();
    }

    private async Task HandleCreer()
    {
        _isCreating = true;
        _createError = null;
        try
        {
            using var client = HttpClientFactory.CreateClient("BiblioApi");
            AjouterAuthorization(client);
            using var response = await client.PostAsJsonAsync("api/livres", _formModel);

            if (!response.IsSuccessStatusCode)
            {
                _createError = await LireErreurHttpAsync(response);
                Logger.LogWarning("POST api/livres a échoué ({StatusCode}) : {Detail}",
                    (int)response.StatusCode, _createError);
                return;
            }

            _successMessage = "Livre ajouté avec succès";
            _afficherFormulaire = false;
            idEnModification = null;
            await ChargerLivres();
            await ChargerLivresDisponibles();
            _ = FaireDisparaitreMessageSucces(_successMessage);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Impossible de joindre l'API pour créer un livre.");
            _createError = $"Impossible de contacter l'API. Détail : {exception.Message}";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erreur inattendue lors de la création d'un livre.");
            _createError = $"Erreur lors de la création du livre : {exception.Message}";
        }
        finally
        {
            _isCreating = false;
        }
    }

    
    private void EmprunterLivre(int livreId)
    {
        Navigation.NavigateTo($"/emprunts?livreId={livreId}");
    }
    
    private async Task<bool> SupprimerLivre(int id)
    {
        if (_isDeleting)
        {
            return false;
        }

        _isDeleting = true;
        _deleteError = null;

        try
        {
            using var client = HttpClientFactory.CreateClient("BiblioApi");
            AjouterAuthorization(client);
            using var response = await client.DeleteAsync($"api/livres/{id}");

            if (!response.IsSuccessStatusCode)
            {
                _deleteError = await LireErreurHttpAsync(response);
                Logger.LogWarning("DELETE api/livres/{LivreId} a échoué ({StatusCode}) : {Detail}",
                    id, (int)response.StatusCode, _deleteError);
                return false;
            }

            _successMessage = "Livre supprimé avec succès";
            await ChargerLivres();
            await ChargerLivresDisponibles();
            _ = FaireDisparaitreMessageSucces(_successMessage);
            return true;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Impossible de joindre l'API pour supprimer le livre {LivreId}.", id);
            _deleteError = $"Impossible de contacter l'API. Détail : {exception.Message}";
            return false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erreur inattendue lors de la suppression du livre {LivreId}.", id);
            _deleteError = $"Erreur lors de la suppression du livre : {exception.Message}";
            return false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void OuvrirConfirmationSuppression(int id, string nom)
    {
        idAConfirmer = id;
        nomAConfirmer = nom;
        _deleteError = null;
        afficherConfirmation = true;
    }

    private void AnnulerConfirmation()
    {
        if (_isDeleting)
        {
            return;
        }

        afficherConfirmation = false;
        idAConfirmer = 0;
        nomAConfirmer = string.Empty;
        _deleteError = null;
    }

    private async Task ConfirmerSuppression()
    {
        if (await SupprimerLivre(idAConfirmer))
        {
            AnnulerConfirmation();
        }
    }

    private async Task ModifierLivre()
    {
        if (!idEnModification.HasValue)
        {
            _createError = "Aucun livre n'est sélectionné pour la modification.";
            return;
        }

        _isCreating = true;
        _createError = null;
        var id = idEnModification.Value;

        try
        {
            using var client = HttpClientFactory.CreateClient("BiblioApi");
            AjouterAuthorization(client);
            using var response = await client.PutAsJsonAsync($"api/livres/{id}", _formModel);

            if (!response.IsSuccessStatusCode)
            {
                _createError = await LireErreurHttpAsync(response);
                Logger.LogWarning("PUT api/livres/{LivreId} a échoué ({StatusCode}) : {Detail}",
                    id, (int)response.StatusCode, _createError);
                return;
            }

            _successMessage = "Livre modifié avec succès";
            _afficherFormulaire = false;
            idEnModification = null;
            await ChargerLivres();
            await ChargerLivresDisponibles();
            _ = FaireDisparaitreMessageSucces(_successMessage);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Impossible de joindre l'API pour modifier le livre {LivreId}.", id);
            _createError = $"Impossible de contacter l'API. Détail : {exception.Message}";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erreur inattendue lors de la modification du livre {LivreId}.", id);
            _createError = $"Erreur lors de la modification du livre : {exception.Message}";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task AfficherFormulaireModification(int id)
    {
        _isLoadingForm = true;
        _errorMessage = null;

        try
        {
            using var client = HttpClientFactory.CreateClient("BiblioApi");
            AjouterAuthorization(client);
            using var response = await client.GetAsync($"api/livres/{id}");
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await LireErreurHttpAsync(response);
                Logger.LogWarning("GET api/livres/{LivreId} a échoué ({StatusCode}) : {Detail}",
                    id, (int)response.StatusCode, _errorMessage);
                return;
            }

            var livre = await response.Content.ReadFromJsonAsync<LivreDto>();
            if (livre is null)
            {
                throw new JsonException($"La réponse GET api/livres/{id} est vide.");
            }

            _formModel = new FormModel
            {
                Titre = livre.Titre,
                ISBN = livre.ISBN,
                DatePublication = livre.DatePublication,
                NombrePages = livre.NombrePages,
                NombreExemplaires = livre.NombreExemplaires,
                AuteurId = livre.AuteurId,
                CategorieId = livre.CategorieId
            };

            idEnModification = id;
            _createError = null;
            _afficherFormulaire = true;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Impossible de joindre l'API pour charger le livre {LivreId}.", id);
            _errorMessage = $"Impossible de contacter l'API. Détail : {exception.Message}";
        }
        catch (JsonException exception)
        {
            Logger.LogError(exception, "La réponse GET api/livres/{LivreId} n'est pas un LivreDto valide.", id);
            _errorMessage = $"Les données du livre sont invalides : {exception.Message}";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erreur inattendue lors du chargement du livre {LivreId}.", id);
            _errorMessage = $"Erreur lors du chargement du livre : {exception.Message}";
        }
        finally
        {
            _isLoadingForm = false;
        }
    }

    private void AppliquerFiltresDepuisUrl()
    {
        if (AuteurIdQuery.HasValue)
            _auteurFiltreId = AuteurIdQuery.Value;

        if (CategorieIdQuery.HasValue)
            _categorieFiltreId = CategorieIdQuery.Value;
    }








    private void AjouterAuthorization(HttpClient client)
    {
        if (!string.IsNullOrWhiteSpace(TokenProvider.Token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);
        }
    }

    private static async Task<string> LireErreurHttpAsync(HttpResponseMessage response)
    {
        var detail = await response.Content.ReadAsStringAsync();
        if (detail.Length > 1000)
        {
            detail = detail[..1000] + "...";
        }

        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            return $"L'API a refusé la requête (401). Connectez-vous à nouveau. {detail}";
        }

        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            return $"Votre rôle ne permet pas cette opération (403). {detail}";
        }

        return string.IsNullOrWhiteSpace(detail)
            ? $"L'API a renvoyé le code HTTP {(int)response.StatusCode} ({response.ReasonPhrase})."
            : $"L'API a renvoyé le code HTTP {(int)response.StatusCode} : {detail}";
    }

    private async Task FaireDisparaitreMessageSucces(string? message)
    {
        await Task.Delay(5000);

        if (_successMessage == message)
        {
            _successMessage = null;
        }

        await InvokeAsync(StateHasChanged);
    }

