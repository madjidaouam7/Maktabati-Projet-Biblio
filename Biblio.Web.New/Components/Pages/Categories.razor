@page "/categories"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Biblio.Web.New.Authentication
@using Biblio.Web.New.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject TokenProvider TokenProvider
@inject NavigationManager Navigation


<PageTitle>Categories</PageTitle>

<h1>Gestion des Categories</h1>

@if (_successMessage is not null)
{
    <div class="alert alert-success">
        @_successMessage
    </div>
}

<AuthorizeView Roles="Admin,Bibliothecaire">
    <Authorized Context="authorizedContext">
        <button class="btn btn-primary mb-3" @onclick="ToggleFormulaire">
            @(_afficherFormulaire ? "Annuler" : "Ajouter une categorie")
        </button>

        <Modal Titre="@(idEnModification.HasValue ? "Modifier une categorie" : "Ajouter une categorie")"
               Visible="@_afficherFormulaire" OnClose="FermerFormulaire">
            <EditForm Model="_formModel" OnValidSubmit="EnregistrerFormulaire">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-2">
                    <label>Nom</label>
                    <InputText class="form-control" @bind-Value="_formModel.Nom" />
                    <ValidationMessage For="@(() => _formModel.Nom)" />
                </div>

                <div class="mb-2">
                    <label>Description</label>
                    <InputText class="form-control" @bind-Value="_formModel.Description" />
                    <ValidationMessage For="@(() => _formModel.Description)" />
                </div>

                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="alert alert-danger">@_createError</div>
                }

                <button type="submit" class="btn btn-success" disabled="@_isCreating">
                    @(_isCreating ? "Enregistrement..." : idEnModification.HasValue ? "Enregistrer les modifications" :
                "Ajouter la categorie")
                </button>
                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="FermerFormulaire">
                    Annuler
                </button>
            </EditForm>
        </Modal>
    </Authorized>
</AuthorizeView>

<input type="text" class="form-control mb-3" style="max-width: 350px;" placeholder="Rechercher une catégorie..."
       @bind="_rechercheCategorie" @bind:event="oninput" />

@if (_isLoading)
{
    <p><em>Chargement...</em></p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_categories is null || !_categories.Any())
{
    <p>Aucune categorie enregistré.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <AuthorizeView Roles="Admin,Bibliothecaire">
                    <Authorized>
                        <th>Actions</th>
                    </Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var categorie in _categories.Where(c =>
    string.IsNullOrWhiteSpace(_rechercheCategorie) ||
    c.Nom.Contains(_rechercheCategorie, StringComparison.OrdinalIgnoreCase)))
            {
                <tr>
                    <td>@categorie.Id</td>
                    <td>@categorie.Nom</td>
                    <td>@categorie.Description</td>
                    <td>
                        <AuthorizeView Roles="Admin,Bibliothecaire">
                            <Authorized>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="() => OuvrirModification(categorie)"><i class="bi bi-pencil-square"></i></button>
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => OuvrirConfirmationSuppression(categorie.Id, categorie.Nom)"><i class="bi bi-trash"></i></button>
                            </Authorized>
                        </AuthorizeView>
                        <button class="btn btn-sm btn-secondary me-1" @onclick="() => VoirLivres(categorie.Id)">
                            Voir livres
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (afficherConfirmation)
{
    <Modal Titre="Supprimer une categorie" Visible="@afficherConfirmation" OnClose="AnnulerConfirmation">
        <p>Voulez-vous vraiment supprimer la categorie <strong>@nomAConfirmer</strong> ?</p>
        <p class="text-muted small">Cette action est irréversible.</p>
        @if (_deleteError is not null)
        {
            <div class="alert alert-danger" role="alert">@_deleteError</div>
        }
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" @onclick="AnnulerConfirmation"
                    disabled="@_isDeleting">Annuler</button>
            <button type="button" class="btn btn-danger" @onclick="ConfirmerSuppression" disabled="@_isDeleting">
                @(_isDeleting ? "Suppression..." : "Supprimer")
            </button>
        </div>
    </Modal>
}

@code {
    private List<CategorieDto>? _categories;
    private FormModel _formModel = new();
    private string? _successMessage;
    private string? _errorMessage;
    private bool _isLoading = true;
    private bool _isCreating;
    private bool _isDeleting;
    private string? _deleteError;
    private bool _afficherFormulaire;
    private string? _createError;
    private int? idEnModification;
    private bool afficherConfirmation;
    private int idAConfirmer;
    private string nomAConfirmer = string.Empty;
    private string _rechercheCategorie = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await ChargerCategories();
    }

    private async Task ChargerCategories()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.GetAsync("api/categories");

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = "Impossible de charger les categories.";
                return;
            }

            var resultat = await response.Content.ReadFromJsonAsync<CategoriesResponse>();
            _categories = resultat?.Categories ?? new List<CategorieDto>();
        }
        catch (Exception)
        {
            _errorMessage = "Une erreur est survenue lors du chargement.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleCreer()
    {
        _isCreating = true;
        _createError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.PostAsJsonAsync("api/categories", _formModel);

            if (!response.IsSuccessStatusCode)
            {
                _createError = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de l'ajout.");
                return;
            }

            _successMessage = "Categorie ajouté avec succès";
            _afficherFormulaire = false;
            await ChargerCategories();
            _ = FaireDisparaitreMessageSucces();
        }
        catch (Exception)
        {
            _createError = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private async Task ModifierCategories()
    {
        if (!idEnModification.HasValue)
        {
            _createError = "Aucune categorie n'est sélectionné pour la modification.";
            return;
        }

        _isCreating = true;
        _createError = null;
        var id = idEnModification.Value;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.PutAsJsonAsync($"api/categories/{id}", _formModel);

            if (!response.IsSuccessStatusCode)
            {
                _createError = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de la modification.");
                return;
            }

            _successMessage = "Categorie modifié avec succès";
            _afficherFormulaire = false;
            await ChargerCategories();
            _ = FaireDisparaitreMessageSucces();
        }
        catch (Exception)
        {
            _createError = "Impossible de contacter le serveur.";
        }
        finally
        {
            _isCreating = false;
        }
    }

    private void OuvrirModification(CategorieDto auteur)
    {
        idEnModification = auteur.Id;

        _formModel = new FormModel
        {
            Nom = auteur.Nom,
            Description = auteur.Description,
        };

        _createError = null;
        _errorMessage = null;
        _afficherFormulaire = true;
    }


    private async Task<bool> SupprimerCategories(int id)
    {
        if (_isDeleting)
        {
            return false;
        }

        _isDeleting = true;
        _deleteError = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", TokenProvider.Token);

            using var response = await client.DeleteAsync($"api/categories/{id}");

            if (!response.IsSuccessStatusCode)
            {
                _deleteError = await ApiErrorMessageReader.ReadAsync(response, "Une erreur est survenue lors de la suppression.");
                return false;
            }

            _successMessage = "Categorie supprimé avec succès";
            _afficherFormulaire = false;
            await ChargerCategories();
            _ = FaireDisparaitreMessageSucces();
            return true;
        }
        catch (Exception)
        {
            _deleteError = "Impossible de contacter le serveur.";
            return false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void OuvrirConfirmationSuppression(int id, string nom)
    {
        idAConfirmer = id;
        nomAConfirmer = nom;
        _deleteError = null;
        afficherConfirmation = true;
    }

    private void AnnulerConfirmation()
    {
        if (_isDeleting)
        {
            return;
        }

        afficherConfirmation = false;
        idAConfirmer = 0;
        nomAConfirmer = string.Empty;
        _deleteError = null;
    }

    private async Task ConfirmerSuppression()
    {
        if (await SupprimerCategories(idAConfirmer))
        {
            AnnulerConfirmation();
        }
    }

    private void VoirLivres(int categorieId)
    {
        Navigation.NavigateTo($"/livres?categorieId={categorieId}");
    }







    private void ToggleFormulaire()
    {
        _afficherFormulaire = !_afficherFormulaire;
        _createError = null;
        _errorMessage = null;
        if (_afficherFormulaire)
        {
            _formModel = new FormModel();
            idEnModification = null;
        }
    }

    private void FermerFormulaire()
    {
        _afficherFormulaire = false;
        _createError = null;
        idEnModification = null;
    }

    private Task EnregistrerFormulaire()
    {
        return idEnModification.HasValue ? ModifierCategories() : HandleCreer();
    }

    private async Task FaireDisparaitreMessageSucces()
    {
        await Task.Delay(5000);

        _successMessage = null;

        await InvokeAsync(StateHasChanged);
    }


    public class CategorieDto
    {
        public int Id { get; set; }
        public string Nom { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
    
    public class CategoriesResponse
    {
        public int Page { get; set; }
        public int TaillePage { get; set; }
        public int TotalElements { get; set; }
        public int TotalPages { get; set; }
        public List<CategorieDto> Categories { get; set; } = new();
    }

    private class FormModel
    {
        [Required(ErrorMessage = "Le nom est obligatoire.")]
        [StringLength(100, ErrorMessage = "Le nom ne peut pas dépasser 100 caractères.")]
        public string Nom { get; set; } = string.Empty;

        [Required(ErrorMessage = "La description est obligatoire.")]
        [StringLength(100, ErrorMessage = "La description ne peut pas dépasser 100 caractères.")]
        public string Description { get; set; } = string.Empty;
    }
}