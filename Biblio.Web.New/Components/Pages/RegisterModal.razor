@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@using Biblio.Web.New.Authentication
@using Biblio.Web.New.DTOs
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpClientFactory
@inject CustomAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

@if (IsOpen)
{
    <div class="register-backdrop" @onclick="CloseAsync" role="presentation">

        <section class="register-modal" role="dialog" aria-modal="true" aria-labelledby="register-title"
                 @onclick:stopPropagation="true">

            <div class="register-modal-header">
                <div>
                    <h2 id="register-title">Créer un compte</h2>
                    <p>Rejoignez la bibliothèque Maktabati.</p>
                </div>

                <button type="button" class="register-close" aria-label="Fermer" disabled="@isLoading"
                        @onclick="CloseAsync">
                    &times;
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @errorMessage
                </div>
            }

            <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister" FormName="HomeRegisterForm">

                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label for="register-prenom" class="form-label">Prénom</label>
                        <InputText id="register-prenom" class="form-control" autocomplete="given-name"
                                   @bind-Value="registerModel.Prenom" />
                        <ValidationMessage For="@(() => registerModel.Prenom)" />
                    </div>

                    <div class="col-sm-6 mb-3">
                        <label for="register-nom" class="form-label">Nom</label>
                        <InputText id="register-nom" class="form-control" autocomplete="family-name"
                                   @bind-Value="registerModel.Nom" />
                        <ValidationMessage For="@(() => registerModel.Nom)" />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="register-email" class="form-label">Adresse e-mail</label>
                    <InputText id="register-email" type="email" class="form-control" autocomplete="email"
                               @bind-Value="registerModel.Email" />
                    <ValidationMessage For="@(() => registerModel.Email)" />
                </div>

                <div class="mb-3">
                    <label for="register-password" class="form-label">Mot de passe</label>
                    <InputText id="register-password" type="password" class="form-control" autocomplete="new-password"
                               @bind-Value="registerModel.MotDePasse" />
                    <div class="form-text">Au moins 6 caractères.</div>
                    <ValidationMessage For="@(() => registerModel.MotDePasse)" />
                </div>

                <div class="mb-4">
                    <label for="register-confirm-password" class="form-label">
                        Confirmer le mot de passe
                    </label>
                    <InputText id="register-confirm-password" type="password" class="form-control"
                               autocomplete="new-password" @bind-Value="registerModel.ConfirmationMotDePasse" />
                    <ValidationMessage For="@(() => registerModel.ConfirmationMotDePasse)" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @(isLoading ? "Création du compte..." : "Créer mon compte")
                </button>
            </EditForm>

            <p class="text-center text-secondary mt-4 mb-0">
                Vous avez déjà un compte ?
                <button type="button" class="btn btn-link p-0 fw-semibold" @onclick="OnLoginClick">
                    Se connecter
                </button>
            </p>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnLoginClick { get; set; }

    private RegisterFormModel registerModel = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task CloseAsync()
    {
        if (isLoading)
            return;

        await OnClose.InvokeAsync();
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("BiblioApi");

            var response = await client.PostAsJsonAsync(
                "api/auth/register",
                new
                {
                    registerModel.Email,
                    registerModel.MotDePasse,
                    registerModel.Nom,
                    registerModel.Prenom
                });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadRegistrationErrorAsync(response);
                return;
            }

            var authResponse =
                await response.Content.ReadFromJsonAsync<AuthResponseDto>();

            if (authResponse is null ||
                string.IsNullOrWhiteSpace(authResponse.Token))
            {
                errorMessage =
                    "Le compte a été créé, mais la réponse d'authentification est invalide. Connectez-vous avec vos identifiants.";
                return;
            }

            await AuthProvider.MarkUserAsAuthenticatedAsync(authResponse.Token);

            var authenticationState =
                await AuthProvider.GetAuthenticationStateAsync();

            if (authenticationState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/accueil", replace: true);
            }
            else
            {
                errorMessage =
                    "Le compte a été créé, mais la connexion n'a pas pu être établie. Connectez-vous avec vos identifiants.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Impossible de contacter l'API. Vérifiez qu'elle est démarrée, puis réessayez.";
        }
        catch (JsonException)
        {
            errorMessage =
                "La réponse de l'API est invalide. Réessayez ou connectez-vous si votre compte a bien été créé.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static async Task<string> ReadRegistrationErrorAsync(
        HttpResponseMessage response)
    {
        var content = await response.Content.ReadAsStringAsync();

        if (string.IsNullOrWhiteSpace(content))
        {
            return "La création du compte a échoué. Vérifiez vos informations et réessayez.";
        }

        try
        {
            using var document = JsonDocument.Parse(content);
            var root = document.RootElement;

            if (root.ValueKind == JsonValueKind.String)
            {
                return root.GetString()
                    ?? "La création du compte a échoué. Vérifiez vos informations et réessayez.";
            }

            if (root.ValueKind == JsonValueKind.Array)
            {
                var messages = root.EnumerateArray()
                    .Where(item => item.ValueKind == JsonValueKind.String)
                    .Select(item => item.GetString())
                    .Where(message => !string.IsNullOrWhiteSpace(message));

                var combinedMessage = string.Join(" ", messages);

                if (!string.IsNullOrWhiteSpace(combinedMessage))
                    return combinedMessage;
            }

            if (root.ValueKind == JsonValueKind.Object)
            {
                foreach (var propertyName in new[] { "detail", "message", "title" })
                {
                    if (root.TryGetProperty(propertyName, out var property)
                        && property.ValueKind == JsonValueKind.String
                        && !string.IsNullOrWhiteSpace(property.GetString()))
                    {
                        return property.GetString()!;
                    }
                }

                if (root.TryGetProperty("errors", out var errors)
                    && errors.ValueKind == JsonValueKind.Object)
                {
                    var validationMessages = errors.EnumerateObject()
                        .SelectMany(error => error.Value.ValueKind == JsonValueKind.Array
                            ? error.Value.EnumerateArray()
                                .Where(item => item.ValueKind == JsonValueKind.String)
                                .Select(item => item.GetString())
                            : Enumerable.Empty<string?>())
                        .Where(message => !string.IsNullOrWhiteSpace(message));

                    var combinedMessage = string.Join(" ", validationMessages);

                    if (!string.IsNullOrWhiteSpace(combinedMessage))
                        return combinedMessage;
                }
            }
        }
        catch (JsonException)
        {
            return content.Trim();
        }

        return "La création du compte a échoué. Vérifiez vos informations et réessayez.";
    }

    private sealed class RegisterFormModel
    {
        [Required(ErrorMessage = "Le prénom est obligatoire.")]
        public string Prenom { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le nom est obligatoire.")]
        public string Nom { get; set; } = string.Empty;

        [Required(ErrorMessage = "L'email est obligatoire.")]
        [EmailAddress(ErrorMessage = "Format d'email invalide.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le mot de passe est obligatoire.")]
        [MinLength(6, ErrorMessage = "Le mot de passe doit contenir au moins 6 caractères.")]
        public string MotDePasse { get; set; } = string.Empty;

        [Required(ErrorMessage = "Veuillez confirmer votre mot de passe.")]
        [Compare(nameof(MotDePasse), ErrorMessage = "Les mots de passe ne correspondent pas.")]
        public string ConfirmationMotDePasse { get; set; } = string.Empty;
    }
}
