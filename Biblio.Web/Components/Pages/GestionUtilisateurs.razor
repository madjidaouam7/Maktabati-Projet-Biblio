@page "/gestion-utilisateurs"
@using Biblio.Web.Services
@inject AuthService AuthService

<PageTitle>Gestion des utilisateurs</PageTitle>

<h1>Créer un Bibliothécaire</h1>

<Notification Message="@message" EstErreur="estErreur" OnFermer="@(() => message = null)" />

<div class="card p-3" style="max-width: 400px;">
    <EditForm Model="nouveauBibliothecaire" OnValidSubmit="Creer">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label>Nom</label>
            <InputText class="form-control" @bind-Value="nouveauBibliothecaire.Nom" />
        </div>

        <div class="mb-2">
            <label>Prénom</label>
            <InputText class="form-control" @bind-Value="nouveauBibliothecaire.Prenom" />
        </div>

        <div class="mb-2">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="nouveauBibliothecaire.Email" />
        </div>

        <div class="mb-2">
            <label>Mot de passe temporaire</label>
            <InputText type="password" class="form-control" @bind-Value="nouveauBibliothecaire.MotDePasse" />
        </div>

        <button type="submit" class="btn btn-primary">Créer le compte</button>
    </EditForm>
</div>

@code {
    private CreerBibliothecaireDto nouveauBibliothecaire = new();
    private string? message;
    private bool estErreur;

    private async Task Creer()
    {
        var (succes, erreur) = await AuthService.CreerBibliothecaireAsync(nouveauBibliothecaire);

        if (succes)
        {
            message = "Bibliothécaire créé avec succès !";
            estErreur = false;
            nouveauBibliothecaire = new();
        }
        else
        {
            message = erreur ?? "Une erreur est survenue.";
            estErreur = true;
        }
    }
}