@page "/categories"
@using Biblio.Web.Services
@inject CategorieService CategorieService

<PageTitle>Categories</PageTitle>

<h1>Categories</h1>

<Notification Message="@message" EstErreur="estErreur" OnFermer="@(() => message = null)" />

<button class="btn btn-primary mb-3" @onclick="AfficherFormulaireCreation">
    + Ajouter une catégorie
</button>

@if (afficherFormulaire)
{
    <div class="card p-3 mb-3">
        <EditForm Model="categorieEnCours" OnValidSubmit="EnregistrerCategorie">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2">
                <label>Nom</label>
                <InputText class="form-control" @bind-Value="categorieEnCours.Nom" />
            </div>

            <div class="mb-2">
                <label>Description</label>
                <InputText class="form-control" @bind-Value="categorieEnCours.Description" />
            </div>

            <button type="submit" class="btn btn-success">Enregistrer</button>
            <button type="button" class="btn btn-secondary" @onclick="AnnulerFormulaire">Annuler</button>
        </EditForm>
    </div>
}

@if (categories == null)
{
    <p><em>Chargement...</em></p>
}
else if (!categories.Any())
{
    <p>Aucune catégorie trouvée.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categorie in categories)
            {
                <tr>
                    <td>@categorie.Id</td>
                    <td>@categorie.Nom</td>
                    <td>@categorie.Description</td>
                    <td>
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => AfficherFormulaireModification(categorie.Id)">Modifier</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => OuvrirConfirmationSuppression(categorie.Id, categorie.Nom)">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}






<!--Confirmation de suppression-->
@if (afficherConfirmation)
{
    <div class="modal-overlay" @onclick="AnnulerConfirmation">
        <div class="modal-container" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" @onclick="AnnulerConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous vraiment supprimer <strong>@nomAConfirmer</strong> ?</p>
                    <p class="text-muted small">Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="AnnulerConfirmation">Annuler</button>
                    <button class="btn btn-danger" @onclick="ConfirmerSuppression">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
}





@code {
    private List<CategorieDto>? categories;
    private bool afficherFormulaire = false;
    private CreateCategorieDto categorieEnCours = new();
    private string? messageErreur;
    private int? idEnModification = null;
    private string? message;
    private bool estErreur;
    private bool afficherConfirmation = false;
    private int idAConfirmer = 0;
    private string nomAConfirmer = "";

    private void AfficherMessage(string texte, bool erreur)
    {
        message = texte;
        estErreur = erreur;
    }


    protected override async Task OnInitializedAsync()
    {
        await ChargerCategories();
    }

    private async Task ChargerCategories()
    {
        categories = await CategorieService.GetCategoriesAsync();
    }

    private void AfficherFormulaireCreation()
    {
        categorieEnCours = new CreateCategorieDto();
        idEnModification = null;
        messageErreur = null;
        afficherFormulaire = true;
    }

    private void AnnulerFormulaire()
    {
        afficherFormulaire = false;
    }

    private async Task EnregistrerCategorie()
    {
        (bool Succes, string? Erreur) resultat;

        if (idEnModification.HasValue)
        {
            resultat = await CategorieService.UpdateCategorieAsync(idEnModification.Value, categorieEnCours);
        }
        else
        {
            resultat = await CategorieService.CreateCategorieAsync(categorieEnCours);
        }

        if (resultat.Succes)
        {
            afficherFormulaire = false;
            await ChargerCategories();
            AfficherMessage(idEnModification.HasValue ? "Catégorie modifiée avec succès !" : "Catégorie créée avec succès !", false);
        }
        else
        {
            AfficherMessage(resultat.Erreur ?? "Une erreur est survenue.", true);
        }
    }

    private async Task SupprimerCategorie(int id)
    {
        var (succes, erreur) = await CategorieService.DeleteCategorieAsync(id);

        if (succes)
        {
            await ChargerCategories();
            AfficherMessage("Catégorie supprimée avec succès !", false);
        }
        else
        {
            AfficherMessage(erreur ?? "Une erreur est survenue.", true);
        }
    }



    private async Task AfficherFormulaireModification(int id)
    {
        var categorie = await CategorieService.GetCategorieAsync(id);
        if (categorie == null)
        {
            messageErreur = "Catégorie introuvable.";
            return;
        }

        categorieEnCours = new CreateCategorieDto
        {
            Nom = categorie.Nom,
            Description = categorie.Description
        };

        idEnModification = id;
        messageErreur = null;
        afficherFormulaire = true;
    }






    <!--Confirmation de suppression-->
    private void OuvrirConfirmationSuppression(int id, string nom)
    {
        idAConfirmer = id;
        nomAConfirmer = nom;
        afficherConfirmation = true;
    }

    private void AnnulerConfirmation()
    {
        afficherConfirmation = false;
        idAConfirmer = 0;
        nomAConfirmer = "";
    }

    private async Task ConfirmerSuppression()
    {
        afficherConfirmation = false;
        var (succes, erreur) = await CategorieService.DeleteCategorieAsync(idAConfirmer);
        if (succes)
        {
            await ChargerCategories();
            AfficherMessage($"Catégorie \"{nomAConfirmer}\" supprimée.", false);
        }
        else
        {
            AfficherMessage(erreur ?? "Une erreur est survenue.", true);
        }
        idAConfirmer = 0;
        nomAConfirmer = "";
    }
}