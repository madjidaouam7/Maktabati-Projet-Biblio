@page "/register"
@using Biblio.Web.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Inscription</PageTitle>

<h1>Inscription</h1>

@if (messageErreur != null)
{
    <div class="alert alert-danger">@messageErreur</div>
}

<div class="card p-3" style="max-width: 400px;">
    <EditForm Model="registerModel" OnValidSubmit="SInscrire">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label>Nom</label>
            <InputText class="form-control" @bind-Value="registerModel.Nom" />
        </div>

        <div class="mb-2">
            <label>Prénom</label>
            <InputText class="form-control" @bind-Value="registerModel.Prenom" />
        </div>

        <div class="mb-2">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="registerModel.Email" />
        </div>

        <div class="mb-2">
            <label>Mot de passe</label>
            <InputText type="password" class="form-control" @bind-Value="registerModel.MotDePasse" />
        </div>

        <button type="submit" class="btn btn-primary">S'inscrire</button>
    </EditForm>

    <p class="mt-2">
        Déjà un compte ? <NavLink href="login">Se connecter</NavLink>
    </p>
</div>

@code {
    private RegisterDto registerModel = new();
    private string? messageErreur;

    private async Task SInscrire()
    {
        var (succes, erreur) = await AuthService.RegisterAsync(registerModel);

        if (succes)
        {
            NavigationManager.NavigateTo("/accueil");
        }
        else
        {
            messageErreur = erreur ?? "Une erreur est survenue lors de l'inscription.";
        }
    }
}