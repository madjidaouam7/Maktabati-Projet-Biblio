@page "/accueil"
@using Biblio.Web.Services
@inject LivreService LivreService
@inject AuteurService AuteurService
@inject CategorieService CategorieService
@inject EmpruntService EmpruntService

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

@if (chargement)
{
    <p><em>Chargement...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-3 mb-3">
            <NavLink href="livres" class="text-decoration-none">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Livres</h5>
                    <p class="card-text fs-2">@nombreLivres</p>
                </div>
            </div>
            </NavLink>
        </div>

        <div class="col-md-3 mb-3">
            <NavLink href="auteurs" class="text-decoration-none">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Auteurs</h5>
                    <p class="card-text fs-2">@nombreAuteurs</p>
                </div>
            </div>
            </NavLink>
        </div>

        <div class="col-md-3 mb-3">
            <NavLink href="categories" class="text-decoration-none">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Catégories</h5>
                    <p class="card-text fs-2">@nombreCategories</p>
                </div>
            </div>
            </NavLink>
        </div>

        <div class="col-md-3 mb-3">
            <NavLink href="emprunts" class="text-decoration-none">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Emprunts actifs</h5>
                    <p class="card-text fs-2">@nombreEmpruntsActifs</p>
                </div>
            </div>
            </NavLink>
        </div>
    </div>
}

@code {
    private bool chargement = true;
    private int nombreLivres;
    private int nombreAuteurs;
    private int nombreCategories;
    private int nombreEmpruntsActifs;

    protected override async Task OnInitializedAsync()
    {
        var livres = await LivreService.GetLivresAsync();
        var auteurs = await AuteurService.GetAuteursAsync();
        var categories = await CategorieService.GetCategoriesAsync();
        var emprunts = await EmpruntService.GetEmpruntsActifsAsync();

        nombreLivres = livres.Count;
        nombreAuteurs = auteurs.Count;
        nombreCategories = categories.Count;
        nombreEmpruntsActifs = emprunts.Count;

        chargement = false;
    }
}