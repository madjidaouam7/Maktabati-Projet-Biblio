@page "/"
@layout Biblio.Web.Components.Layout.PublicLayout

<PageTitle>Bienvenue - Biblio</PageTitle>

<section class="container py-5">
    <div class="row align-items-center min-vh-75">
        <div class="col-lg-7 py-5">
            <span class="badge bg-primary-subtle text-primary mb-3">
                Bibliothèque numérique
            </span>

            <h1 class="display-4 fw-bold mb-4">
                Découvrez, empruntez et gérez
                vos livres facilement.
            </h1>

            <p class="lead text-secondary mb-4">
                Explorez notre catalogue, consultez les livres disponibles
                et gérez vos emprunts et réservations depuis une seule plateforme.
            </p>

            <div class="d-flex gap-3 flex-wrap">
                <a href="/register" class="btn btn-primary btn-lg px-4">
                    Commencer
                </a>

                <a href="/login" class="btn btn-outline-primary btn-lg px-4">
                    Se connecter
                </a>
            </div>
        </div>

        <div class="col-lg-5 text-center">
            <div class="display-1">📚</div>
            <h3 class="fw-bold mt-3">Votre bibliothèque, partout.</h3>
        </div>
    </div>
</section>