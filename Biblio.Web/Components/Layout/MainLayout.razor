@inherits LayoutComponentBase
@using Biblio.Web.Services
@inject EtatAuthService EtatAuth
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (EtatAuth.EstConnecte)
            {
                <span class="me-3">Connecté : @EtatAuth.Email</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SeDeconnecter">Déconnexion</button>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        var page = new Uri(NavigationManager.Uri).AbsolutePath;
        var pagesPubliques = new[] { "/login", "/register" };

        if (!EtatAuth.EstConnecte && !pagesPubliques.Contains(page))
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private void SeDeconnecter()
    {
        EtatAuth.Deconnecter();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}